# Lucresia Service Configuration
# Copy this file to .env.local and add your API keys

# Google Gemini API Key (used as Lucresia engine)
# Get your key at: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Future: Lucresia API (when available)
# VITE_LUCRESIA_API_URL=https://api.lucresia.com
# VITE_LUCRESIA_API_KEY=your_lucresia_key_here
